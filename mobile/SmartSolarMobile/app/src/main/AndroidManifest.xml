<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartSolarMobile"
        android:usesCleartextTraffic="false">

        <!-- Google Maps -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Shared / Member 1 station discovery -->
        <activity
            android:name=".ui.stations.StationDiscoveryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.stations.StationDetailActivity"
            android:exported="false" />

        <!-- Shared home -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <!-- Member 2 account/profile -->
        <activity
            android:name=".ui.account.AccountActivity"
            android:exported="false" />

        <!-- Member 3 reservation lifecycle -->
        <activity
            android:name=".ui.reservation.CreateReservationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.reservation.ReservationDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.reservation.ModifyReservationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.reservation.ReservationSummaryActivity"
            android:exported="false" />

        <!-- Member 4 booking / QR flows -->
        <activity
            android:name=".ui.reservations.CurrentBookingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.reservations.BookingHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.reservations.ReservationQrActivity"
            android:exported="false" />

        <activity
            android:name=".ui.reservations.QrScannerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.reservations.QrVerificationResultActivity"
            android:exported="false" />

        <!-- Launcher / authentication -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>