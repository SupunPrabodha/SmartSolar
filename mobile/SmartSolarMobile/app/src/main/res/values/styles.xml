<resources>
    <style name="Solar.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/solar_radius_small</item><item name="android:minHeight">@dimen/solar_control_height</item>
        <item name="android:textSize">14sp</item><item name="android:insetTop">4dp</item><item name="android:insetBottom">4dp</item>
    </style>
    <style name="Solar.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/solar_radius_small</item><item name="android:minHeight">@dimen/solar_control_height</item><item name="android:textSize">14sp</item>
    </style>
    <style name="Solar.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">@dimen/solar_radius_small</item><item name="android:minHeight">@dimen/solar_control_height</item><item name="android:textSize">14sp</item>
    </style>
    <style name="Solar.Button.Danger" parent="Solar.Button.Outlined">
        <item name="android:textColor">@color/btn_danger_text</item>
        <item name="strokeColor">@color/btn_danger_stroke</item>
    </style>
    <style name="Solar.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/solar_radius_small</item><item name="boxCornerRadiusTopEnd">@dimen/solar_radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/solar_radius_small</item><item name="boxCornerRadiusBottomEnd">@dimen/solar_radius_small</item>
    </style>
    <style name="Solar.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
    </style>
    <style name="Solar.Status" parent="">
        <item name="android:textSize">12sp</item><item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">@dimen/solar_radius_small</item><item name="android:paddingVertical">4dp</item>
    </style>
    <style name="Solar.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/Solar.Shape.Dialog</item>
        <item name="colorSurface">@color/solar_surface</item>
    </style>
    <style name="Solar.Shape.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/solar_radius_large</item>
    </style>
    <style name="Solar.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/solar_approved_surface</item>
    </style>
</resources>
