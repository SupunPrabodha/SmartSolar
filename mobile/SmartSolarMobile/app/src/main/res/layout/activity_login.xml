<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/loginRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/solar_screen_padding">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/solar_space_lg" android:background="@drawable/bg_solar_hero">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <com.google.android.material.card.MaterialCardView android:layout_width="48dp" android:layout_height="48dp" app:cardBackgroundColor="@color/solar_hero" app:cardCornerRadius="@dimen/solar_radius_small" app:strokeWidth="0dp" android:importantForAccessibility="no">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp" android:src="@drawable/ic_solar_brand" android:importantForAccessibility="no"/>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/solar_space_md" android:orientation="vertical">
        <TextView style="@style/Solar.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand_name" android:textColor="@color/solar_hero_text" />
        <TextView style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand_subtitle" android:textColor="@color/solar_hero_text" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/solar_space_xl" android:text="@string/login_title" android:textColor="@color/solar_hero_text" android:textAppearance="?attr/textAppearanceHeadlineLarge" android:textStyle="bold" />
<TextView style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_description" android:textColor="@color/solar_hero_text" android:layout_marginTop="@dimen/solar_space_md" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp" android:padding="20dp" android:background="@drawable/bg_solar_surface">
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:hint="@string/nic_hint">
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/editNic" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textNoSuggestions" android:singleLine="true" android:autofillHints="username" android:imeOptions="actionNext" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/solar_space_base" android:hint="@string/password_hint" app:endIconMode="password_toggle">
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/editPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:singleLine="true" android:autofillHints="password" android:saveEnabled="false" />
</com.google.android.material.textfield.TextInputLayout>
<TextView android:id="@+id/textError" style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/solar_space_base" android:textColor="?attr/colorError" android:accessibilityLiveRegion="polite" android:visibility="gone" />
<ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/solar_space_base" android:contentDescription="@string/working" android:visibility="gone" />
<com.google.android.material.button.MaterialButton android:id="@+id/buttonLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/sign_in" android:layout_marginTop="20dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/buttonCreateAccount" style="@style/Solar.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/create_account" />
<TextView style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_roles" android:layout_marginTop="20dp" android:textSize="12sp" />
</LinearLayout>
<TextView style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/foundation_footer" android:layout_marginTop="40dp" android:textSize="12sp" android:gravity="center" />
</LinearLayout>
</ScrollView>
