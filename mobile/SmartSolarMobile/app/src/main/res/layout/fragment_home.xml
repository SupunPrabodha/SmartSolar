<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/homeRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/solar_screen_padding">
  <TextView android:id="@+id/textSession" style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/checking_session" android:accessibilityLiveRegion="polite" android:textSize="12sp"/>
  <TextView android:id="@+id/textError" style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorError" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
  <LinearLayout android:id="@+id/profileContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/solar_space_md" android:orientation="vertical" android:padding="@dimen/solar_space_lg" android:background="@drawable/bg_solar_hero">
   <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_solar_brand" android:importantForAccessibility="no"/>
   <TextView android:id="@+id/textWelcome" style="@style/Solar.Title" android:textColor="@color/solar_hero_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/solar_space_md"/>
   <TextView android:id="@+id/homeDescription" style="@style/Solar.Body" android:textColor="@color/solar_hero_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
   <TextView android:id="@+id/textAccountStatus" style="@style/Solar.Status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
   </LinearLayout>
   <com.smartsolar.mobile.ui.common.LoadingSurface android:id="@+id/progress" android:tag="metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:contentDescription="@string/visual_loading_metrics" android:visibility="gone"/>
   <LinearLayout android:id="@+id/homeMetrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/solar_space_base" android:orientation="horizontal" android:baselineAligned="false">
    <com.google.android.material.card.MaterialCardView style="@style/Solar.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp">
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/solar_card_padding" android:background="@drawable/bg_visual_brand">
      <View android:layout_width="32dp" android:layout_height="4dp" android:layout_marginBottom="10dp" android:background="@color/solar_accent" android:importantForAccessibility="no"/>
      <TextView style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nav_pending"/>
      <TextView android:id="@+id/textPendingCount" style="@style/Solar.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/unavailable_value" android:textSize="30sp"/>
     </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView style="@style/Solar.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp">
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/solar_card_padding" android:background="@drawable/bg_visual_brand">
      <View android:layout_width="32dp" android:layout_height="4dp" android:layout_marginBottom="10dp" android:background="@color/solar_emerald" android:importantForAccessibility="no"/>
      <TextView style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/approved_future_short"/>
      <TextView android:id="@+id/textApprovedFutureCount" style="@style/Solar.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/unavailable_value" android:textSize="30sp"/>
     </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
   </LinearLayout>
<com.google.android.material.card.MaterialCardView style="@style/Solar.Card" app:cardBackgroundColor="@color/solar_surface_strong" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView style="@style/Solar.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/enterprise_recent" android:textSize="18sp" app:drawableStartCompat="@drawable/ic_nav_history" android:drawablePadding="10dp"/>
<com.smartsolar.mobile.ui.common.LoadingSurface android:id="@+id/activitySkeleton" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/visual_loading_activity" android:visibility="gone"/>
   <TextView android:id="@+id/textRecentActivity" style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></com.google.android.material.card.MaterialCardView>
   <TextView android:id="@+id/textMetricsStatus" style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/solar_space_sm" android:textSize="12sp"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/buttonScanTransaction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/solar_space_base" app:icon="@drawable/ic_nav_scan" android:text="@string/scan_transaction_qr" android:visibility="gone"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/buttonModuleTwo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/solar_space_base" android:text="@string/new_reservation" android:visibility="gone"/>
<com.google.android.material.card.MaterialCardView style="@style/Solar.Card" app:cardBackgroundColor="@color/solar_content_surface" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView style="@style/Solar.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quick_actions" android:textSize="18sp"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/buttonCurrentBookings" style="@style/Solar.Button.Tonal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start|center_vertical" app:icon="@drawable/ic_nav_bookings" android:text="@string/current_bookings"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/buttonPendingBookings" style="@style/Solar.Button.Tonal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start|center_vertical" app:icon="@drawable/ic_nav_history" android:text="@string/pending_bookings"/>
</LinearLayout></com.google.android.material.card.MaterialCardView>
  </LinearLayout>

 </LinearLayout>
</ScrollView>
