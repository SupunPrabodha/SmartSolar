<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/catalogRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<com.google.android.material.button.MaterialButton android:id="@+id/catalogBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/catalog_back" />
<TextView style="@style/Solar.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/find_stations" android:id="@+id/discoveryTitle" />
<TextView android:id="@+id/locationStatus" style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/location_explanation" android:accessibilityLiveRegion="polite" android:layout_marginVertical="12dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/findNearby" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/find_nearby" /><com.google.android.material.button.MaterialButton android:id="@+id/showAllStations" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/all_stations" />
<TextView android:id="@+id/mapStatus" style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/map_alternative" />
<FrameLayout android:id="@+id/stationMap" android:layout_width="match_parent" android:layout_height="280dp" android:layout_marginVertical="12dp" />
<ProgressBar android:id="@+id/catalogProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:contentDescription="@string/working" android:visibility="gone" />
<TextView android:id="@+id/catalogMessage" style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:layout_marginVertical="12dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/catalogRetry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/catalog_retry" />
<LinearLayout android:id="@+id/stationList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
</LinearLayout></ScrollView>
