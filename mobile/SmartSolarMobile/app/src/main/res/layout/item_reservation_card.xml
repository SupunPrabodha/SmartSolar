<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Solar.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/solar_space_base"
    app:cardCornerRadius="14dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/solar_border">

    <!--
        Outer card container.
        The status accent is retained from Merge-M1-M4.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Reservation status accent -->
        <View
            android:id="@+id/viewStatusAccent"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_status_accent_bar" />

        <!-- Main reservation content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- ========================================================= -->
            <!-- COLLAPSED / SUMMARY HEADER                               -->
            <!-- ========================================================= -->

            <LinearLayout
                android:id="@+id/cardHeader" android:background="@color/solar_surface_soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/solar_card_padding"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp">

                <!-- Energy amount + reservation status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textCardEnergy"
                        style="@style/Solar.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/solar_text" />

                    <TextView
                        android:id="@+id/textCardStatus"
                        style="@style/Solar.Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!--
                    Compact schedule preview retained from the polished
                    IT23187450 reservation card.
                -->
                <TextView
                    android:id="@+id/textCardStartPreview"
                    style="@style/Solar.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/solar_space_sm"
                    android:textColor="@color/solar_text"
                    android:textSize="14sp" />

                <!-- Station -->
                <TextView
                    android:id="@+id/textCardStation"
                    style="@style/Solar.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/solar_space_sm"
                    android:textColor="@color/solar_secondary"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Reservation reference + vector expand chevron -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!--
                        Kept for compatibility with the polished Prosumer
                        reservation renderer. It consumes zero meaningful
                        space when no value is bound.
                    -->
                    <TextView
                        android:id="@+id/textCardIdSnippet"
                        style="@style/Solar.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/solar_secondary"
                        android:textSize="12sp" />

                    <!--
                        Vector chevron.
                        Java rotates this ImageView instead of replacing
                        Unicode arrow characters.
                    -->
                    <ImageView
                        android:id="@+id/textChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/solar_space_xs"
                        android:src="@drawable/ic_ui_chevron"
                        android:importantForAccessibility="no" />

                </LinearLayout>

            </LinearLayout>

            <!-- ========================================================= -->
            <!-- EXPANDED DETAILS                                         -->
            <!-- ========================================================= -->

            <LinearLayout
                android:id="@+id/layoutExpandedDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/solar_space_base"
                android:paddingEnd="@dimen/solar_space_base"
                android:paddingBottom="@dimen/solar_space_base"
                android:visibility="gone">

                <!-- Separator -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="@dimen/solar_space_md"
                    android:background="?attr/colorOutlineVariant" />

                <!-- ===================================================== -->
                <!-- SCHEDULE DETAILS                                      -->
                <!-- ===================================================== -->

                <!-- Start + End -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Accepted / scheduled start -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_detail_tile"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            style="@style/Solar.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_accepted_start"
                            android:textColor="@color/solar_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textExpandedStart"
                            style="@style/Solar.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/solar_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Accepted / scheduled end -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_detail_tile"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            style="@style/Solar.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_accepted_end"
                            android:textColor="@color/solar_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textExpandedEnd"
                            style="@style/Solar.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/solar_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Change / cancellation cutoff -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_detail_tile"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/Solar.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_change_cutoff"
                        android:textColor="@color/solar_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textExpandedCutoff"
                        style="@style/Solar.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/solar_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- ===================================================== -->
                <!-- REJECTION MESSAGE                                     -->
                <!-- ===================================================== -->

                <LinearLayout
                    android:id="@+id/layoutRejectionNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/solar_space_md"
                    android:padding="@dimen/solar_space_md"
                    android:background="@drawable/bg_rejection_notice"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rejection_reason_formatted"
                        android:textColor="@color/solar_status_rejected"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textRejectionRemark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/solar_space_xs"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- ===================================================== -->
                <!-- RESERVATION RESTRICTION MESSAGE                       -->
                <!-- ===================================================== -->

                <TextView
                    android:id="@+id/textExpandedRestriction"
                    style="@style/Solar.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/solar_space_sm"
                    android:padding="10dp"
                    android:background="@drawable/bg_restriction_banner"
                    android:textColor="@color/solar_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- ===================================================== -->
                <!-- ACTION BUTTONS                                        -->
                <!-- ===================================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/solar_space_base"
                    android:orientation="vertical">

                    <!-- Modify + Cancel -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCardModify"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/solar_space_xs"
                            android:minHeight="48dp"
                            android:paddingHorizontal="4dp"
                            android:text="@string/btn_modify_reservation"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCardCancel"
                            style="@style/Solar.Button.Danger"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/solar_space_xs"
                            android:minHeight="48dp"
                            android:paddingHorizontal="4dp"
                            android:text="@string/btn_cancel_reservation"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Approved reservation actions -->
                    <LinearLayout
                        android:id="@+id/layoutCardApprovedActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/solar_space_sm"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCardViewQr"
                            style="@style/Solar.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/solar_space_xs"
                            android:minHeight="48dp"
                            android:paddingHorizontal="4dp"
                            android:text="@string/view_qr_code"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCardGetDirections"
                            style="@style/Solar.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/solar_space_xs"
                            android:minHeight="48dp"
                            android:paddingHorizontal="4dp"
                            android:text="@string/btn_get_directions"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
