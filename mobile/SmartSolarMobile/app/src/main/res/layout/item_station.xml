<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Solar.Card" app:cardBackgroundColor="@color/solar_content_surface" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="@dimen/solar_space_sm">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/solar_card_padding">
<ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="10dp" android:background="@drawable/bg_visual_brand" android:layout_marginBottom="@dimen/solar_space_md" android:src="@drawable/ic_nav_stations" app:tint="@color/solar_primary" android:importantForAccessibility="no"/>
<TextView android:id="@+id/stationName" style="@style/Solar.Title" android:layout_width="match_parent" android:layout_height="wrap_content" />
<TextView android:id="@+id/stationSummary" style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/solar_space_sm" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:background="@drawable/bg_visual_brand" android:padding="12dp" android:baselineAligned="false">
<TextView android:id="@+id/stationCapacity" style="@style/Solar.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingEnd="8dp"/>
<TextView android:id="@+id/stationSlots" style="@style/Solar.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
<TextView android:id="@+id/stationDistance" style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="@dimen/solar_space_sm" />
<com.google.android.material.button.MaterialButton style="@style/Solar.Button.Outlined" android:id="@+id/stationOpen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/view_station" />
</LinearLayout></com.google.android.material.card.MaterialCardView>
