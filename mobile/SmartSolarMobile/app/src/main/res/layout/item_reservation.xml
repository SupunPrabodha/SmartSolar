<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Solar.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/solar_space_base"
    app:cardCornerRadius="14dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/solar_border">

    <!-- Outer Container with Left Status Accent Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left Status Color Accent Strip -->
        <View
            android:id="@+id/viewStatusAccent"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_status_accent_bar" />

        <!-- Main Card Contents -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Clickable Base Header -->
            <LinearLayout
                android:id="@+id/cardHeader" android:background="@color/solar_brand_surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/solar_card_padding"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp">

                <!-- Top Row: Energy Amount + Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textCardEnergy"
                        style="@style/Solar.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/solar_text" />

                    <TextView
                        android:id="@+id/textCardStatus"
                        style="@style/Solar.Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Station Name + Vector Chevron -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/textCardStation"
                        style="@style/Solar.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="@color/solar_secondary"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <ImageView
                        android:id="@+id/textChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/solar_space_xs"
                        android:src="@drawable/ic_ui_chevron"
                        android:importantForAccessibility="no" />

                </LinearLayout>

                <!-- Timestamp / Cutoff Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <!-- Start + End Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Scheduled Start -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_detail_tile"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                style="@style/Solar.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/label_accepted_start"
                                android:textColor="@color/solar_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textExpandedStart"
                                style="@style/Solar.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/solar_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Scheduled End -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_detail_tile"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                style="@style/Solar.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/label_accepted_end"
                                android:textColor="@color/solar_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textExpandedEnd"
                                style="@style/Solar.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/solar_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Change Cutoff -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_detail_tile"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            style="@style/Solar.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_change_cutoff"
                            android:textColor="@color/solar_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textExpandedCutoff"
                            style="@style/Solar.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/solar_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Expanded Details and Actions -->
            <LinearLayout
                android:id="@+id/layoutExpandedDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/solar_space_base"
                android:paddingEnd="@dimen/solar_space_base"
                android:paddingBottom="@dimen/solar_space_base"
                android:visibility="gone">

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="@dimen/solar_space_md"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Rejection Notice -->
                <LinearLayout
                    android:id="@+id/layoutRejectionNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/solar_space_md"
                    android:background="@drawable/bg_rejection_notice"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rejection_reason_formatted"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/solar_status_rejected" />

                    <TextView
                        android:id="@+id/textRejectionRemark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/solar_space_xs"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface" />

                </LinearLayout>

                <!-- Restriction Notice -->
                <TextView
                    android:id="@+id/textExpandedRestriction"
                    style="@style/Solar.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/solar_space_sm"
                    android:padding="10dp"
                    android:background="@drawable/bg_restriction_banner"
                    android:textColor="@color/solar_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/solar_space_base"
                    android:orientation="vertical">

                    <!-- Modify + Cancel -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCardModify"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/solar_space_xs"
                            android:minHeight="48dp"
                            android:paddingHorizontal="4dp"
                            android:textSize="13sp"
                            android:text="@string/btn_modify_reservation" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCardCancel"
                            style="@style/Solar.Button.Danger"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/solar_space_xs"
                            android:minHeight="48dp"
                            android:paddingHorizontal="4dp"
                            android:textSize="13sp"
                            android:text="@string/btn_cancel_reservation" />

                    </LinearLayout>

                    <!-- Approved Actions -->
                    <LinearLayout
                        android:id="@+id/layoutCardApprovedActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/solar_space_sm"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCardViewQr"
                            style="@style/Solar.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/solar_space_xs"
                            android:minHeight="48dp"
                            android:paddingHorizontal="4dp"
                            android:textSize="13sp"
                            android:text="@string/view_qr_code" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCardGetDirections"
                            style="@style/Solar.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/solar_space_xs"
                            android:minHeight="48dp"
                            android:paddingHorizontal="4dp"
                            android:textSize="13sp"
                            android:text="@string/btn_get_directions" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
