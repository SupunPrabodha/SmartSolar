<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/solar_screen_padding">

        <!-- Top Header & New Reservation button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">




            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonHeaderNewReservation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/btn_new_reservation_header"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Feedback & Status Messages -->
        <TextView
            android:id="@+id/textError"
            style="@style/Solar.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="?attr/colorError"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textSuccess"
            style="@style/Solar.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/solar_primary"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/working"
            android:visibility="gone" />

        <!-- Empty State View -->
        <TextView
            android:id="@+id/textEmptyState"
            style="@style/Solar.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="@dimen/solar_screen_padding"
            android:gravity="center"
            android:background="@color/solar_background"
            android:text="@string/no_reservations_found"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Dynamic List Container for Reservation Cards -->
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/buttonCurrentView" style="@style/Solar.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_current"/>
<com.google.android.material.button.MaterialButton android:id="@+id/buttonPendingView" style="@style/Solar.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_pending"/>
<com.google.android.material.button.MaterialButton android:id="@+id/buttonSearchView" style="@style/Solar.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_search"/></LinearLayout></HorizontalScrollView>
<LinearLayout
            android:id="@+id/layoutReservationsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp" />

        <!-- Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRefreshDetails"
                style="@style/Solar.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="@string/btn_refresh_details" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBackHome"
                style="@style/Solar.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/btn_back_to_workspace"  android:visibility="gone"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
