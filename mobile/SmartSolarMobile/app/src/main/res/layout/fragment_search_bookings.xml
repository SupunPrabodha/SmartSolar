<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/solar_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/solar_screen_padding">
 <TextView  style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/search_guidance" />
 <com.google.android.material.card.MaterialCardView style="@style/Solar.Card" app:cardBackgroundColor="@color/solar_brand_surface" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
 <TextView style="@style/Solar.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/polishFilterHeading" android:text="@string/polish_filters" android:textSize="18sp" app:drawableStartCompat="@drawable/ic_ui_filter" android:drawablePadding="10dp"/>
 <com.google.android.material.textfield.TextInputLayout style="@style/Solar.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:startIconDrawable="@drawable/ic_nav_bookings" android:hint="@string/reservation_id_hint"><com.google.android.material.textfield.TextInputEditText android:id="@+id/searchReservationId" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textNoSuggestions"/></com.google.android.material.textfield.TextInputLayout>
 <com.google.android.material.textfield.TextInputLayout style="@style/Solar.Input" android:id="@+id/searchNicField" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:startIconDrawable="@drawable/ic_nav_account" android:hint="@string/label_prosumer_nic"><com.google.android.material.textfield.TextInputEditText android:id="@+id/searchProsumerNic" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textNoSuggestions"/></com.google.android.material.textfield.TextInputLayout>
 <com.google.android.material.textfield.TextInputLayout style="@style/Solar.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:startIconDrawable="@drawable/ic_nav_stations" android:hint="@string/label_station_id"><com.google.android.material.textfield.TextInputEditText android:id="@+id/searchStationId" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textNoSuggestions"/></com.google.android.material.textfield.TextInputLayout>
 <TextView  style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_status" android:layout_marginTop="12dp"/>
 <Spinner android:id="@+id/searchStatus" android:background="@drawable/bg_visual_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:contentDescription="@string/label_status"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp"><com.google.android.material.button.MaterialButton android:id="@+id/buttonSearch" app:icon="@drawable/ic_nav_search" style="@style/Solar.Button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/search_button"/><com.google.android.material.button.MaterialButton android:id="@+id/buttonClear" app:icon="@drawable/ic_ui_refresh" style="@style/Solar.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/clear_filters"/></LinearLayout>
 </LinearLayout></com.google.android.material.card.MaterialCardView>
 <TextView style="@style/Solar.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:id="@+id/polishResultHeading" android:text="@string/polish_results" android:textSize="20sp"/>
 <com.smartsolar.mobile.ui.common.LoadingSurface android:id="@+id/searchProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" android:contentDescription="@string/visual_loading_results" android:visibility="gone"/>
 <TextView android:id="@+id/searchMessage" app:drawableStartCompat="@drawable/ic_nav_search" style="@style/Solar.Body" android:background="@drawable/bg_visual_strong" android:padding="16dp" android:layout_marginVertical="12dp" android:drawablePadding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"  android:paddingVertical="12dp" android:accessibilityLiveRegion="polite"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/searchResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
</LinearLayout></androidx.core.widget.NestedScrollView>
