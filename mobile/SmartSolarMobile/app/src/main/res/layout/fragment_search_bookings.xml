<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/solar_screen_padding">
 <TextView  style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/search_guidance" />
 <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/reservation_id_hint"><com.google.android.material.textfield.TextInputEditText android:id="@+id/searchReservationId" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textNoSuggestions"/></com.google.android.material.textfield.TextInputLayout>
 <com.google.android.material.textfield.TextInputLayout android:id="@+id/searchNicField" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/label_prosumer_nic"><com.google.android.material.textfield.TextInputEditText android:id="@+id/searchProsumerNic" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textNoSuggestions"/></com.google.android.material.textfield.TextInputLayout>
 <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/label_station_id"><com.google.android.material.textfield.TextInputEditText android:id="@+id/searchStationId" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textNoSuggestions"/></com.google.android.material.textfield.TextInputLayout>
 <TextView  style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_status" android:layout_marginTop="12dp"/>
 <Spinner android:id="@+id/searchStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:contentDescription="@string/label_status"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp"><com.google.android.material.button.MaterialButton android:id="@+id/buttonSearch" style="@style/Solar.Button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/search_button"/><com.google.android.material.button.MaterialButton android:id="@+id/buttonClear" style="@style/Solar.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/clear_filters"/></LinearLayout>
 <ProgressBar android:id="@+id/searchProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:visibility="gone"/>
 <TextView android:id="@+id/searchMessage" style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content"  android:paddingVertical="12dp" android:accessibilityLiveRegion="polite"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/searchResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
</LinearLayout></androidx.core.widget.NestedScrollView>
