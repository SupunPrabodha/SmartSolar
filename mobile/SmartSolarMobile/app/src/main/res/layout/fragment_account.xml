<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/solar_screen_padding">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_solar_hero" android:padding="@dimen/solar_space_lg">
  <TextView android:id="@+id/accountInitials" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:textColor="@color/solar_primary" android:textSize="28sp" android:background="@drawable/bg_visual_brand" android:importantForAccessibility="no"/>
  <TextView android:id="@+id/profileName" android:textColor="@color/solar_hero_text" android:layout_marginTop="@dimen/solar_space_md" style="@style/Solar.Title" android:layout_width="match_parent" android:layout_height="wrap_content"  />
  <TextView  style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/accountIdentity" android:textColor="@color/solar_hero_text" android:layout_marginTop="@dimen/solar_space_xs"/>
  <TextView android:id="@+id/profileNic" style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content"  android:textColor="@color/solar_hero_text" />
  </LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="16dp" android:background="@drawable/bg_visual_brand">
  <TextView  style="@style/Solar.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_information" android:layout_marginTop="@dimen/solar_space_lg" android:textSize="18sp"/>


  <com.google.android.material.textfield.TextInputLayout style="@style/Solar.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/solar_space_md" android:hint="@string/full_name_hint"><com.google.android.material.textfield.TextInputEditText android:id="@+id/inputName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName"/></com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/solar_space_md" android:hint="@string/email_hint"><com.google.android.material.textfield.TextInputEditText android:id="@+id/inputEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress"/></com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/solar_space_md" android:hint="@string/phone_hint"><com.google.android.material.textfield.TextInputEditText android:id="@+id/inputPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone"/></com.google.android.material.textfield.TextInputLayout>
  <TextView android:id="@+id/textResult" style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content"  android:accessibilityLiveRegion="polite" android:paddingTop="@dimen/solar_space_md"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/buttonSave" style="@style/Solar.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save_profile"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="16dp" android:background="@drawable/bg_visual_brand">
<TextView style="@style/Solar.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/visual_security" android:textSize="18sp" app:drawableStartCompat="@drawable/ic_ui_shield" android:drawablePadding="10dp"/>
<TextView style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/visual_account_security_hint" android:layout_marginVertical="12dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/buttonPhotoSecurity" style="@style/Solar.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/visual_open_security"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="16dp" android:background="@drawable/bg_visual_danger">

  <TextView  style="@style/Solar.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_access" android:textSize="16sp"/>
  <TextView  style="@style/Solar.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/deactivation_confirmation" android:layout_marginVertical="@dimen/solar_space_sm"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/buttonDeactivate" style="@style/Solar.Button.Danger" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/deactivate_account"/>
 </LinearLayout>
</LinearLayout>
</ScrollView>
